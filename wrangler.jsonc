{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oh-my-feed-discover",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "discover.ohmyfeed.stream",
      "custom_domain": true
    },
    {
      "pattern": "ohmyfeed.stream",
      "custom_domain": true
    }
  ]
}
